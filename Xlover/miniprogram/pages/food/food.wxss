.sum {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sum-value {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.15;
}

.sum-unit {
  font-size: var(--fs-cap);
  font-weight: 500;
  color: var(--text-light);
  margin-left: 8rpx;
}

.sum-cap {
  font-size: var(--fs-cap);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.sum-tag {
  padding-top: 8rpx;
}

.meal-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--gap-xs);
}

.meal-kcal {
  font-size: var(--fs-cap);
  color: var(--text-secondary);
}

.unit-sm {
  font-size: var(--fs-micro);
  color: var(--text-light);
  margin-left: 4rpx;
}

.meal-empty {
  padding: 24rpx 0;
  font-size: var(--fs-cap);
  color: var(--text-light);
}

.meal-add {
  margin-top: var(--gap-sm);
  padding: 20rpx 0;
  text-align: center;
  font-size: var(--fs-cap);
  color: var(--primary);
  background: var(--primary-light);
  border-radius: var(--radius);
}

.meal-add:active {
  opacity: 0.75;
}

.container-pad {
  height: 24rpx;
}

/* ---------------- 面板 ---------------- */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 82vh;
  background: #fff;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--gap-md) var(--gap-lg);
  border-bottom: 1rpx solid var(--border);
}

.sheet-close {
  font-size: var(--fs-cap);
  color: var(--text-light);
}

.sheet-body {
  padding: var(--gap-md) var(--gap-lg) var(--gap-lg);
  max-height: 66vh;
}

.picked {
  padding: var(--gap-md);
  background: var(--bg-page);
  border-radius: var(--radius);
  margin-bottom: var(--gap-md);
}

.picked-name {
  font-size: var(--fs-h2);
  font-weight: 600;
  margin-bottom: 6rpx;
}

.picked-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.picked-change {
  font-size: var(--fs-micro);
  color: var(--primary);
}

.preset-row {
  display: flex;
  gap: var(--gap-xs);
  margin-top: var(--gap-xs);
}

.preset {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: var(--fs-micro);
  color: var(--text-secondary);
  background: var(--bg-page);
  border-radius: var(--radius-sm);
}

.preview {
  padding: var(--gap-md);
  background: var(--primary-light);
  border-radius: var(--radius);
  text-align: center;
}

.preview-main {
  font-size: 52rpx;
  font-weight: 700;
  color: #3D7EB5;
}

.preview-macros {
  font-size: var(--fs-cap);
  color: #3D7EB5;
  margin: 6rpx 0;
}

.sheet-actions {
  display: flex;
  gap: var(--gap-sm);
  margin-top: var(--gap-lg);
}

.sheet-actions .btn {
  flex: 1;
}

.chips {
  white-space: nowrap;
  margin-bottom: var(--gap-sm);
}

.chip-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  font-size: var(--fs-micro);
  color: var(--text-secondary);
  background: var(--bg-page);
  border-radius: var(--radius-pill);
}

.chip-item.active {
  background: var(--primary);
  color: #fff;
}

.results {
  min-height: 200rpx;
}

.food-icon {
  font-size: 40rpx;
  width: 64rpx;
  text-align: center;
  margin-right: var(--gap-sm);
}
