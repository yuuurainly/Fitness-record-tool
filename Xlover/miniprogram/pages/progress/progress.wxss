.badge-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 20rpx 10rpx;
  border-radius: var(--radius);
  background: var(--bg-page);
}

.badge-item.locked {
  opacity: 0.4;
}

.badge-item.unlocked {
  background: var(--primary-light);
}

.badge-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.badge-name {
  font-size: 22rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.badge-desc {
  font-size: 18rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.calendar-month {
  font-size: 30rpx;
  font-weight: 600;
}

.calendar-nav {
  display: flex;
  gap: 32rpx;
  font-size: 36rpx;
  color: var(--primary);
}

.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  margin-bottom: 12rpx;
}

.calendar-weekdays text {
  font-size: 24rpx;
  color: var(--text-light);
}

.calendar-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.calendar-day {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
  font-size: 26rpx;
  position: relative;
}

.calendar-day.empty {
  background: transparent;
}

.calendar-day.checked {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}

.calendar-day.today {
  border: 2rpx solid var(--primary);
}

.check-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-top: 4rpx;
}

.calendar-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
}

.legend-dot.checked {
  background: var(--primary-light);
}

.legend-dot.today {
  border: 2rpx solid var(--primary);
  background: transparent;
}

.chart-container {
  padding: 20rpx 0;
}

.trend-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trend-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.trend-date {
  width: 100rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: right;
}

.trend-bar-container {
  flex: 1;
  height: 16rpx;
  background: var(--bg-page);
  border-radius: 8rpx;
  overflow: hidden;
}

.trend-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--primary-dark));
  border-radius: 8rpx;
  transition: width 0.5s;
}

.trend-value {
  width: 80rpx;
  font-size: 24rpx;
  color: var(--text-primary);
  text-align: right;
}

.stats-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.stats-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stats-icon {
  font-size: 36rpx;
  width: 48rpx;
  text-align: center;
}

.stats-info {
  flex: 1;
}

.stats-name {
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.stats-bar-container {
  height: 12rpx;
  background: var(--bg-page);
  border-radius: 6rpx;
  overflow: hidden;
}

.stats-bar {
  height: 100%;
  background: var(--secondary);
  border-radius: 6rpx;
  transition: width 0.5s;
}

.stats-value {
  width: 100rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: right;
}

.card-title.foldable {
  display: flex;
  align-items: center;
  cursor: pointer;
}

.fold-arrow {
  margin-left: auto;
  font-size: 28rpx;
  color: var(--text-light);
}

/* ===== 任务统计 ===== */
.task-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.task-stat-item {
  text-align: center;
  padding: 16rpx 0;
}

.task-stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.task-stat-label {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.task-rate-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0,0,0,0.05);
}

.task-rate-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.task-rate-track {
  flex: 1;
  height: 16rpx;
  background: var(--bg-page);
  border-radius: 8rpx;
  overflow: hidden;
}

.task-rate-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--secondary), #4CAF50);
  border-radius: 8rpx;
  transition: width 0.5s;
}

.task-rate-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--secondary);
  flex-shrink: 0;
  width: 80rpx;
  text-align: right;
}

.points-summary {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}

.points-main {
  text-align: center;
}

.points-number {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--warning);
}

.points-number.clickable {
  cursor: pointer;
}

.points-number.clickable:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.points-label {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

/* ===== 积分调整弹窗 ===== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 32rpx calc(48rpx + 100rpx + env(safe-area-inset-bottom));
}

.points-modal {
  text-align: center;
  padding-top: 40rpx;
}

.points-modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.points-modal-current {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

.points-modal-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--warning);
}

.points-modal .form-group {
  text-align: left;
  margin-bottom: 24rpx;
}

.points-modal .form-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.points-modal .form-input {
  width: 100%;
  background: var(--bg-page);
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 72rpx;
}

.points-modal .modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.points-modal .modal-actions .btn {
  flex: 1;
}
