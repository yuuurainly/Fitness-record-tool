.range {
  margin-bottom: var(--gap-md);
}

.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--gap-md);
}

.chart {
  width: 100%;
  height: 380rpx;
}

.chart-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: var(--fs-cap);
  color: var(--text-light);
}

.chart-summary {
  display: flex;
  margin-bottom: var(--gap-md);
}

.cs-item {
  flex: 1;
}

.cs-value {
  font-size: 38rpx;
  font-weight: 700;
}

.cs-value.up {
  color: var(--danger);
}

.cs-value.down {
  color: var(--secondary);
}

.cs-label {
  font-size: var(--fs-micro);
  color: var(--text-light);
  margin-top: 2rpx;
}

.subhead {
  font-size: var(--fs-cap);
  color: var(--text-secondary);
  margin-bottom: var(--gap-sm);
}

.macro-hist-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.mh-date {
  width: 90rpx;
  font-size: var(--fs-micro);
  color: var(--text-light);
}

.mh-bars {
  flex: 1;
  display: flex;
  gap: 6rpx;
}

.mh-bar {
  flex: 1;
  height: 14rpx;
  background: var(--track);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.mh-fill {
  height: 100%;
  border-radius: var(--radius-pill);
}

.mh-empty {
  flex: 1;
  font-size: var(--fs-micro);
  color: var(--text-light);
}

.bar-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.bar-date {
  width: 90rpx;
  font-size: var(--fs-micro);
  color: var(--text-light);
}

.bar-track {
  flex: 1;
  height: 16rpx;
  background: var(--track);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: var(--primary);
  border-radius: var(--radius-pill);
}

.bar-value {
  width: 80rpx;
  text-align: right;
  font-size: var(--fs-micro);
  color: var(--text-secondary);
}

.goal-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.goal-row:last-child {
  border-bottom: none;
}

.goal-date {
  flex: 1;
  display: flex;
  flex-direction: column;
  font-size: var(--fs-cap);
}

.goal-nums {
  font-size: var(--fs-cap);
  color: var(--text-secondary);
}

.goal-nums .muted {
  color: var(--text-light);
}

.goal-diff {
  width: 110rpx;
  text-align: right;
  font-size: var(--fs-cap);
  font-weight: 600;
}

.goal-diff .up {
  color: var(--danger);
}

.goal-diff .down {
  color: var(--secondary);
}

.empty-all {
  text-align: center;
  padding: 72rpx 40rpx;
}

.empty-title {
  font-size: var(--fs-h2);
  font-weight: 600;
  margin-bottom: var(--gap-sm);
}

.empty-desc {
  font-size: var(--fs-cap);
  color: var(--text-secondary);
  margin-bottom: var(--gap-lg);
}

.empty-actions {
  display: flex;
  gap: var(--gap-sm);
  justify-content: center;
}
