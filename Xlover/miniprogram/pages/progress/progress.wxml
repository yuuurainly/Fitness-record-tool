<view class="container">

  <view class="range">
    <segmented options="{{rangeOptions}}" value="{{range}}" bind:change="onRange" />
  </view>

  <view class="card empty-all" wx:if="{{!hasAnyData}}">
    <view class="empty-title">还没有可统计的数据</view>
    <view class="empty-desc">记录一次饮食、训练或体重后，这里会显示趋势。</view>
    <view class="empty-actions">
      <view class="btn btn-secondary btn-sm" bindtap="goFood">去记饮食</view>
      <view class="btn btn-secondary btn-sm" bindtap="goTraining">去记训练</view>
      <view class="btn btn-secondary btn-sm" bindtap="goBody">去记体重</view>
    </view>
  </view>

  <block wx:if="{{hasAnyData}}">

    <!-- 体重趋势 -->
    <view class="card">
      <view class="card-head">
        <text class="h2">体重趋势</text>
        <text class="micro" wx:if="{{weight.hasData}}">近 {{weight.days}} 天 · kg</text>
      </view>

      <block wx:if="{{weight.hasEnough}}">
        <view class="chart-summary">
          <view class="cs-item">
            <view class="cs-value num">{{weight.first}}</view>
            <view class="cs-label">起始</view>
          </view>
          <view class="cs-item">
            <view class="cs-value num">{{weight.last}}</view>
            <view class="cs-label">最新</view>
          </view>
          <view class="cs-item">
            <view class="cs-value num {{weight.delta > 0 ? 'up' : 'down'}}">{{weight.delta > 0 ? '+' : ''}}{{weight.delta}}</view>
            <view class="cs-label">变化</view>
          </view>
        </view>
        <canvas type="2d" id="weightChart" class="chart"></canvas>
      </block>

      <view class="chart-empty" wx:elif="{{weight.hasData}}">只有 1 条体重记录，至少 2 条才能画出趋势。</view>
      <view class="chart-empty" wx:else>这段时间没有体重记录。</view>
    </view>

    <!-- 热量摄入 -->
    <view class="card">
      <view class="card-head">
        <text class="h2">每日热量摄入</text>
        <text class="micro" wx:if="{{intake.hasData}}">近 {{intake.days}} 天 · kcal</text>
      </view>
      <canvas type="2d" id="intakeChart" class="chart" wx:if="{{intake.hasData}}"></canvas>
      <view class="chart-empty" wx:else>这段时间没有饮食记录。</view>
      <view class="micro mt-16" wx:if="{{intake.hasData}}">虚线为当日目标；超出目标的柱子会标红。没有目标快照的日期不画目标线。</view>
    </view>

    <!-- 营养素完成度 -->
    <view class="card">
      <view class="card-head">
        <text class="h2">营养素完成度</text>
        <text class="micro">{{macroDateLabel}}</text>
      </view>
      <macro-bar
        wx:for="{{macroToday}}"
        wx:key="key"
        label="{{item.label}}"
        value="{{item.value}}"
        target="{{item.target}}"
        unit="{{item.unit}}"
        color="{{item.color}}"
      />

      <block wx:if="{{macro.hasData}}">
        <view class="divider"></view>
        <view class="subhead">近 {{macro.days}} 天达标情况</view>
        <view class="macro-hist">
          <view class="macro-hist-row" wx:for="{{macro.points}}" wx:key="date">
            <text class="mh-date">{{item.label}}</text>
            <view class="mh-bars" wx:if="{{item.percent}}">
              <view class="mh-bar"><view class="mh-fill" style="width: {{item.percent.carb > 100 ? 100 : item.percent.carb}}%; background: var(--macro-carb)"></view></view>
              <view class="mh-bar"><view class="mh-fill" style="width: {{item.percent.protein > 100 ? 100 : item.percent.protein}}%; background: var(--macro-protein)"></view></view>
              <view class="mh-bar"><view class="mh-fill" style="width: {{item.percent.fat > 100 ? 100 : item.percent.fat}}%; background: var(--macro-fat)"></view></view>
            </view>
            <text class="mh-empty" wx:else>无数据</text>
          </view>
        </view>
        <view class="micro">「无数据」表示当天记录缺少营养素（多为历史导入），不计为 0。</view>
      </block>
    </view>

    <!-- 训练时长 -->
    <view class="card">
      <view class="card-head">
        <text class="h2">训练时长</text>
        <text class="micro" wx:if="{{training.hasData}}">近 {{training.days}} 天 · 分钟</text>
      </view>
      <block wx:if="{{training.hasData}}">
        <view class="chart-summary">
          <view class="cs-item">
            <view class="cs-value num">{{training.totalMinutes}}</view>
            <view class="cs-label">总分钟</view>
          </view>
          <view class="cs-item">
            <view class="cs-value num">{{training.activeDays}}</view>
            <view class="cs-label">训练天数</view>
          </view>
          <view class="cs-item">
            <view class="cs-value num">{{training.avgWeeklyMinutes}}</view>
            <view class="cs-label">周均分钟</view>
          </view>
        </view>
        <view class="bar-list">
          <view class="bar-row" wx:for="{{training.points}}" wx:key="date">
            <text class="bar-date">{{item.label}}</text>
            <view class="bar-track">
              <view class="bar-fill" style="width: {{training.peakMinutes ? item.minutes * 100 / training.peakMinutes : 0}}%"></view>
            </view>
            <text class="bar-value num">{{item.minutes}}</text>
          </view>
        </view>
      </block>
      <view class="chart-empty" wx:else>这段时间没有训练记录。</view>
    </view>

    <!-- 历史目标与实际 -->
    <view class="card">
      <view class="card-head">
        <text class="h2">历史目标与实际</text>
        <text class="micro" wx:if="{{goals.hasData}}">最近 {{goals.rows.length}} 条</text>
      </view>
      <view class="goal-row" wx:for="{{goals.rows}}" wx:key="date">
        <view class="goal-date">
          <text>{{item.date}}</text>
          <text class="micro">{{item.goal}} · {{item.mode}}</text>
        </view>
        <view class="goal-nums num">
          <text wx:if="{{item.actualKcal !== null}}">{{item.actualKcal}} / {{item.targetKcal}} kcal</text>
          <text wx:else class="muted">目标 {{item.targetKcal}} kcal · 当日无进食记录</text>
        </view>
        <view class="goal-diff num" wx:if="{{item.diffKcal !== null}}">
          <text class="{{item.diffKcal > 0 ? 'up' : 'down'}}">{{item.diffKcal > 0 ? '+' : ''}}{{item.diffKcal}}</text>
        </view>
      </view>
      <view class="chart-empty" wx:if="{{goals.rows.length === 0}}">还没有目标快照记录。</view>
    </view>

  </block>
</view>
