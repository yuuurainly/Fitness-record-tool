.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--gap-md);
}

.restore {
  font-size: var(--fs-cap);
  color: var(--primary);
  padding: 8rpx 20rpx;
  background: var(--primary-light);
  border-radius: var(--radius-pill);
}

.meal-empty {
  padding: 24rpx 0;
  font-size: var(--fs-cap);
  color: var(--text-light);
}
