.guide-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 60rpx 40rpx;
}

.guide-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.guide-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60rpx;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.4;
  transition: opacity 0.3s;
}

.step-item.active {
  opacity: 1;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.step-item.active .step-num {
  background: var(--primary);
  color: #fff;
}

.step-content {
  text-align: center;
}

.step-title {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.step-desc {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.step-line {
  width: 60rpx;
  height: 2rpx;
  background: var(--border);
  margin: 0 20rpx;
  margin-bottom: 40rpx;
}

.guide-form {
  flex: 1;
}

.form-tip {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 40rpx;
}

.role-select {
  display: flex;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.role-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 40rpx 24rpx;
  text-align: center;
  border: 2rpx solid transparent;
  box-shadow: var(--shadow);
  transition: all 0.3s;
}

.role-card.selected {
  border-color: var(--primary);
  background: var(--primary-light);
}

.role-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.role-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.role-desc {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.form-group {
  background: var(--bg-card);
  border-radius: var(--radius);
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.form-group input,
.picker-value {
  font-size: 30rpx;
  color: var(--text-primary);
  height: 48rpx;
}

.picker-value {
  display: flex;
  align-items: center;
}

.bind-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 40rpx;
}

.guide-footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
  padding: 40rpx 0;
}

/* ===== 头像选择 ===== */
.avatar-picker-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar-picker-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  position: relative;
  line-height: 1;
  overflow: visible;
}

.avatar-picker-btn::after {
  border: none;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--bg-page);
}

.avatar-edit-icon {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.avatar-hint {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 16rpx;
}
