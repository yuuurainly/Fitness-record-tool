<view class="container">
  <!-- 今日运动总览 -->
  <view class="card total-card">
    <view class="total-title">今日运动消耗</view>
    <view class="total-value">{{totalCalories}} <text class="total-unit">kcal</text></view>
    <view class="total-breakdown">
      <view class="breakdown-item">
        <view class="breakdown-icon">👟</view>
        <view class="breakdown-value">{{werunStep}} 步</view>
        <view class="breakdown-label">≈ {{werunCalories}} kcal</view>
      </view>
      <view class="breakdown-divider"></view>
      <view class="breakdown-item">
        <view class="breakdown-icon">🏃</view>
        <view class="breakdown-value">{{todayDuration}} min</view>
        <view class="breakdown-label">≈ {{todayCalories}} kcal</view>
      </view>
    </view>
  </view>

  <!-- 记录运动 -->
  <view class="card">
    <view class="section-header">
      <view class="card-title">
        <view class="card-title-icon"></view>
        <text>记录运动</text>
      </view>
      <view class="add-type-btn" bindtap="showAddTypeModal">+ 自定义类型</view>
    </view>

    <view class="form-group">
      <view class="form-label foldable" bindtap="toggleTypes">
        <text>运动类型</text>
        <text class="fold-arrow">{{expandTypes ? '收起 ↑' : '展开 ↓'}}</text>
      </view>
      <view class="exercise-types">
        <view class="type-tag {{selectedType === item.type ? 'selected' : ''}} {{index >= 4 && !expandTypes ? 'type-hidden' : ''}}" wx:for="{{exerciseTypes}}" wx:key="type" bindtap="selectType" data-type="{{item.type}}">
          <text class="type-icon">{{item.icon}}</text>
          <text class="type-name">{{item.name}}</text>
          <text class="type-met" wx:if="{{item.met}}">MET {{item.met}}</text>
          <view class="delete-custom" catchtap="deleteCustomType" data-type="{{item.type}}" wx:if="{{item.type.startsWith('custom_')}}">✕</view>
        </view>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">运动时长 (分钟)</text>
      <input type="digit" placeholder="请输入运动时长" value="{{duration}}" bindinput="inputDuration" cursor-spacing="{{120}}" />
    </view>

    <view class="form-group" wx:if="{{estimatedCalories > 0}}">
      <text class="form-label">预计消耗</text>
      <view class="estimated-calories">{{estimatedCalories}} kcal</view>
    </view>

    <button class="btn btn-primary {{!selectedType || !duration ? 'btn-disabled' : ''}}" bindtap="addExercise">添加记录</button>
  </view>

  <!-- 今日运动记录 -->
  <view class="card" wx:if="{{todayExercises.length > 0}}">
    <view class="card-title">
      <view class="card-title-icon"></view>
      <text>今日记录</text>
    </view>
    <view class="exercise-list">
      <view class="exercise-item" wx:for="{{todayExercises}}" wx:key="_id">
        <view class="exercise-icon">{{item.icon}}</view>
        <view class="exercise-info">
          <view class="exercise-name">{{item.typeName}}</view>
          <view class="exercise-detail">{{item.duration}} 分钟 · {{item.calories}} kcal</view>
        </view>
        <view class="exercise-actions">
          <button class="btn-point" size="mini" bindtap="openPointModal" data-id="{{item._id}}" data-name="{{item.typeName}}">申请积分</button>
          <view class="exercise-delete" bindtap="deleteExercise" data-id="{{item._id}}">✕</view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 积分申请弹窗 -->
<view class="modal" wx:if="{{showPointModal}}">
  <view class="modal-mask" bindtap="closePointModal"></view>
  <view class="modal-content">
    <view class="modal-title">申请运动积分</view>
    <view class="form-group">
      <text class="form-label">运动项目</text>
      <view class="form-value">{{pointExerciseName}}</view>
    </view>
    <view class="form-group">
      <text class="form-label">申请积分</text>
      <input type="number" placeholder="请输入积分数值" value="{{pointValue}}" bindinput="inputPointValue" cursor-spacing="{{120}}" />
    </view>
    <view class="modal-actions">
      <button class="btn btn-secondary" bindtap="closePointModal">取消</button>
      <button class="btn btn-primary" bindtap="submitPointRequest">提交申请</button>
    </view>
  </view>
</view>

<!-- 添加自定义类型弹窗 -->
<view class="modal" wx:if="{{showAddType}}">
  <view class="modal-mask" bindtap="closeAddTypeModal"></view>
  <view class="modal-content">
    <view class="modal-title">添加自定义运动</view>
    <view class="form-group">
      <text class="form-label">运动名称</text>
      <input type="text" placeholder="例如：羽毛球" value="{{customTypeName}}" bindinput="inputCustomTypeName" />
    </view>
    <view class="form-group">
      <text class="form-label">MET 值</text>
      <input type="digit" placeholder="例如：5.5（可搜索运动MET值）" value="{{customTypeMet}}" bindinput="inputCustomTypeMet" cursor-spacing="{{120}}" />
      <view class="form-tip">MET值越高消耗热量越多，跑步约9.8，散步约3.8</view>
    </view>
    <view class="modal-actions">
      <button class="btn btn-secondary" bindtap="closeAddTypeModal">取消</button>
      <button class="btn btn-primary" bindtap="saveCustomType">保存</button>
    </view>
  </view>
</view>
