.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--gap-md);
}

.unit-sm {
  font-size: var(--fs-micro);
  color: var(--text-light);
  margin-left: 4rpx;
}

/* ---------- 统计 ---------- */

.stat-row {
  display: flex;
}

.stat {
  flex: 1;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stat-unit {
  font-size: var(--fs-micro);
  font-weight: 500;
  color: var(--text-light);
  margin-left: 4rpx;
}

.stat-label {
  font-size: var(--fs-micro);
  color: var(--text-light);
  margin-top: 4rpx;
}

/* ---------- 推荐 ---------- */

.rec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--gap-sm);
  padding: var(--gap-md);
  background: var(--primary-light);
  border-radius: var(--radius);
  margin-bottom: var(--gap-sm);
}

.rec-main {
  flex: 1;
  min-width: 0;
}

.rec .btn {
  flex-shrink: 0;
}

.rec-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: #3D7EB5;
}

.rec .micro {
  color: #5D93B8;
}

/* ---------- 档位 ---------- */

.band-list {
  margin-bottom: var(--gap-sm);
}

.band {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.band-radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #D8DDE4;
  margin-right: var(--gap-sm);
  flex-shrink: 0;
  box-sizing: border-box;
}

.band.active .band-radio,
.band-radio.active {
  border-color: var(--primary);
  background: var(--primary);
  box-shadow: inset 0 0 0 6rpx #fff;
}

.band-label {
  font-size: var(--fs-body);
  font-weight: 500;
}

.band-coef {
  font-size: var(--fs-micro);
  color: var(--text-light);
  margin-top: 2rpx;
}

.custom-toggle {
  display: flex;
  align-items: center;
  padding: var(--gap-sm) 0;
  font-size: var(--fs-body);
  color: var(--text-secondary);
}

.custom-body {
  padding-top: var(--gap-sm);
  border-top: 1rpx solid var(--border);
}

.custom-save {
  margin-top: var(--gap-sm);
}

/* ---------- 记录 ---------- */

.date-pick {
  font-size: var(--fs-cap);
  color: var(--primary);
  background: var(--primary-light);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap-xs);
}

.type-item {
  width: calc((100% - 3 * var(--gap-xs)) / 4);
  padding: 18rpx 0;
  text-align: center;
  background: var(--bg-page);
  border-radius: var(--radius);
  border: 1rpx solid transparent;
  box-sizing: border-box;
}

.type-item.active {
  background: var(--primary-light);
  border-color: var(--primary);
}

.type-name {
  font-size: var(--fs-cap);
  font-weight: 500;
}

.type-met {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 2rpx;
}

.preset-row {
  display: flex;
  gap: var(--gap-xs);
  margin-top: var(--gap-xs);
}

.preset {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: var(--fs-micro);
  color: var(--text-secondary);
  background: var(--bg-page);
  border-radius: var(--radius-sm);
}

.kcal-preview {
  padding: var(--gap-md);
  background: var(--bg-page);
  border-radius: var(--radius);
  font-size: var(--fs-cap);
  color: var(--text-secondary);
  line-height: 1.7;
}

.kcal-preview .strong {
  font-size: 34rpx;
  color: var(--text-primary);
  font-weight: 700;
  margin: 0 4rpx;
}

.meal-empty {
  padding: 24rpx 0;
  font-size: var(--fs-cap);
  color: var(--text-light);
}
