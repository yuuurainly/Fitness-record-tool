.remind-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.remind-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.remind-item:last-child {
  border-bottom: none;
}

.remind-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.remind-icon {
  font-size: 40rpx;
}

.remind-detail {
  flex: 1;
}

.remind-name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.remind-desc {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.remind-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time-picker {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
  min-width: 80rpx;
  text-align: right;
}

.delete-btn {
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 32rpx;
  color: #ff4d4f;
  border-radius: 50%;
  background: rgba(255, 77, 79, 0.1);
}

/* 添加提醒表单 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-header .card-title {
  margin-bottom: 0;
}

.add-type-btn {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.add-form {
  padding-top: 8rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.form-input {
  background: var(--bg-page);
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.time-display {
  color: var(--primary);
  font-weight: 500;
}

.icon-selector {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg-page);
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
}

.icon-current {
  font-size: 44rpx;
}

.icon-arrow {
  font-size: 24rpx;
  color: var(--text-light);
}

.icon-picker {
  margin-top: 16rpx;
  background: var(--bg-page);
  border-radius: var(--radius);
  padding: 20rpx;
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.icon-option {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: var(--radius);
  background: #fff;
  border: 2rpx solid transparent;
}

.icon-option.selected {
  border-color: var(--primary);
  background: var(--primary-light);
}

.tip-card {
  background: var(--primary-light);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-top: 24rpx;
}

.tip-text {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* ===== 伴侣来源标签 ===== */
.partner-tag {
  font-size: 20rpx;
  color: #ff6b9d;
  background: rgba(255, 107, 157, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 400;
  vertical-align: middle;
  margin-left: 8rpx;
}

.partner-remind {
  background: rgba(255, 107, 157, 0.03);
  border-radius: var(--radius);
  padding: 16rpx;
}

.for-partner {
  background: rgba(255, 107, 157, 0.03);
  border-radius: var(--radius);
  padding: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.empty-hint {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
  padding: 32rpx 0;
}

/* ===== 添加提醒弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-dialog {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.25s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close {
  font-size: 40rpx;
  color: var(--text-light);
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
}

.modal-body {
  padding-bottom: 16rpx;
}
