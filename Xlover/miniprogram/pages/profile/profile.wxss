.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--gap-md);
}

.head-card {
  padding: var(--gap-lg);
}

.head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.head-name {
  font-size: var(--fs-h2);
  font-weight: 600;
}

.head-edit {
  font-size: var(--fs-cap);
  color: var(--primary);
}

.head-line {
  font-size: var(--fs-cap);
  color: var(--text-secondary);
  margin-top: var(--gap-xs);
}

.head-line.muted {
  color: var(--text-light);
}

.head-plan {
  display: flex;
  align-items: flex-end;
  gap: var(--gap-lg);
  margin-top: var(--gap-md);
  padding-top: var(--gap-md);
  border-top: 1rpx solid var(--border);
}

.hp-item {
  display: flex;
  flex-direction: column;
}

.hp-value {
  font-size: 36rpx;
  font-weight: 700;
}

.hp-label {
  font-size: var(--fs-micro);
  color: var(--text-light);
}

.hp-plan {
  margin-left: auto;
}

.hp-plan .hp-value {
  font-size: var(--fs-cap);
  font-weight: 500;
  color: var(--primary);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  opacity: 0.6;
}

.menu-icon {
  font-size: 40rpx;
  width: 64rpx;
}

.menu-body {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: var(--fs-body);
  font-weight: 500;
}

.menu-desc {
  font-size: var(--fs-micro);
  color: var(--text-light);
  margin-top: 2rpx;
}

.count-row {
  display: flex;
}

.count-item {
  flex: 1;
}

.count-value {
  font-size: 38rpx;
  font-weight: 700;
}

.count-label {
  font-size: var(--fs-micro);
  color: var(--text-light);
  margin-top: 2rpx;
}
