<view class="container">

  <!-- 资料摘要 -->
  <view class="card head-card">
    <view class="head-top">
      <view class="head-name">我的身体资料</view>
      <view class="head-edit" bindtap="goBody">{{hasProfile ? '编辑' : '去填写'}} ›</view>
    </view>
    <view class="head-line">{{profileLine}}</view>
    <view class="head-plan" wx:if="{{estimate}}">
      <view class="hp-item">
        <text class="num hp-value">{{estimate.bmr}}</text>
        <text class="hp-label">BMR</text>
      </view>
      <view class="hp-item">
        <text class="num hp-value">{{estimate.tdee}}</text>
        <text class="hp-label">TDEE</text>
      </view>
      <view class="hp-item hp-plan">
        <text class="hp-value">{{planLine}}</text>
      </view>
    </view>
    <view class="head-line muted" wx:else>{{planLine}}</view>
  </view>

  <!-- 功能入口 -->
  <view class="card">
    <view class="menu-item" bindtap="goBody">
      <view class="menu-icon">🧍</view>
      <view class="menu-body">
        <view class="menu-title">身体资料</view>
        <view class="menu-desc">性别、年龄、身高体重、活动水平</view>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goPlan">
      <view class="menu-icon">🎯</view>
      <view class="menu-body">
        <view class="menu-title">营养计划</view>
        <view class="menu-desc">减脂 / 增肌、BMR、TDEE、三大营养素目标</view>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goTraining">
      <view class="menu-icon">🏋️</view>
      <view class="menu-body">
        <view class="menu-title">训练与系数档位</view>
        <view class="menu-desc">训练记录、4 周推荐档位、自定义系数</view>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goProgress">
      <view class="menu-icon">📈</view>
      <view class="menu-body">
        <view class="menu-title">统计与历史</view>
        <view class="menu-desc">体重趋势、热量与营养素完成度</view>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goData">
      <view class="menu-icon">🗂️</view>
      <view class="menu-body">
        <view class="menu-title">数据管理</view>
        <view class="menu-desc">导出备份、导入恢复、数据版本</view>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goDiagnostics">
      <view class="menu-icon">🧪</view>
      <view class="menu-body">
        <view class="menu-title">数据自检</view>
        <view class="menu-desc">存储配额、备份链路、云端迁移</view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 数据概览 -->
  <view class="card">
    <view class="card-head">
      <text class="h2">本地数据</text>
      <text class="micro">最近一次更新：本次打开</text>
    </view>
    <view class="count-row">
      <view class="count-item">
        <view class="count-value num">{{counts.body}}</view>
        <view class="count-label">体重记录</view>
      </view>
      <view class="count-item">
        <view class="count-value num">{{counts.food}}</view>
        <view class="count-label">饮食记录</view>
      </view>
      <view class="count-item">
        <view class="count-value num">{{counts.workout}}</view>
        <view class="count-label">训练记录</view>
      </view>
      <view class="count-item">
        <view class="count-value num">{{counts.snapshots}}</view>
        <view class="count-label">目标快照</view>
      </view>
    </view>
    <view class="micro mt-16">
      占用约 {{usage.usedKB}} KB / 总配额 {{usage.limitSizeKB}} KB · 导入前备份 {{backupCount}} 份
    </view>
  </view>

  <!-- 关于 -->
  <view class="card">
    <view class="menu-item" bindtap="showAbout">
      <view class="menu-icon">ℹ️</view>
      <view class="menu-body">
        <view class="menu-title">关于与版本</view>
        <view class="menu-desc">版本 {{appVersion}} · 数据格式 v{{schemaVersion}} · 食物库 {{libraryVersion}}</view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

</view>
