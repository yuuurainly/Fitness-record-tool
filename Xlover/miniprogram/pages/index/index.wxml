<view class="container">

  <!-- 顶部问候 -->
  <view class="head">
    <view class="head-left">
      <view class="greeting">{{greeting}}</view>
      <view class="date">{{dateLabel}} · {{weekdayLabel}}</view>
    </view>
    <view class="head-plan" bindtap="goPlan" wx:if="{{ready && planReady}}">
      <text>{{goalLabel}} · {{modeLabel}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 未填写资料 -->
  <view class="card empty-card" wx:if="{{!loading && !ready}}">
    <view class="empty-title">先完善身体资料</view>
    <view class="empty-desc">填写性别、身高、体重、年龄和活动水平后，才能计算你的热量与营养素目标。</view>
    <view class="btn btn-primary" bindtap="goBody">去填写</view>
  </view>

  <block wx:if="{{ready}}">

    <!-- 计划未就绪 -->
    <view class="notice notice-warn" wx:if="{{!planReady}}">
      {{planMessage}}
      <view class="notice-action" bindtap="goPlan">前往营养计划 ›</view>
    </view>

    <!-- 主指标：剩余热量 -->
    <view class="card hero" wx:if="{{planReady}}">
      <view class="hero-label">{{overBudget ? '已超出' : '今日还可摄入'}}</view>
      <view class="hero-value num {{overBudget ? 'is-over' : ''}}">
        {{overBudget ? -remainingKcal : remainingKcal}}
        <text class="hero-unit">kcal</text>
      </view>

      <view class="hero-track">
        <view class="hero-fill {{overBudget ? 'is-over' : ''}}" style="width: {{caloriePercent}}%"></view>
      </view>

      <view class="hero-foot">
        <text class="num">已摄入 {{intake.kcal}}</text>
        <text class="num">目标 {{targets.kcal}}</text>
      </view>

      <view class="hero-note" wx:if="{{targetSource === 'computed'}}">目标由当前计划推算，将在今日首次记录时冻结</view>
    </view>

    <!-- 三大营养素 -->
    <view class="card" wx:if="{{planReady}}">
      <view class="section-head">
        <text class="h2">营养素</text>
        <text class="micro" wx:if="{{!intake.macrosComplete}}">部分记录缺少营养素，未计入</text>
      </view>
      <macro-bar
        wx:for="{{macroRows}}"
        wx:key="key"
        label="{{item.label}}"
        value="{{item.value}}"
        target="{{item.target}}"
        unit="{{item.unit}}"
        color="{{item.color}}"
      />
    </view>

    <!-- 训练 / 体重 双列 -->
    <view class="duo">
      <view class="card duo-card" bindtap="goTraining">
        <view class="duo-label">今日训练</view>
        <view class="duo-value num">
          {{training.minutes}}<text class="duo-unit">分钟</text>
        </view>
        <view class="duo-foot num">{{training.kcal}} kcal · {{training.entries}} 次</view>
      </view>

      <view class="card duo-card" bindtap="goWeight">
        <view class="duo-label">最近体重</view>
        <view class="duo-value num">
          {{weight ? weight.value : '--'}}<text class="duo-unit">kg</text>
        </view>
        <view class="duo-foot num" wx:if="{{weight}}">
          <text wx:if="{{weight.delta !== null}}">{{weight.delta > 0 ? '+' : ''}}{{weight.delta}} kg · </text>{{weight.date}}
        </view>
        <view class="duo-foot" wx:else>还没有记录</view>
      </view>
    </view>

    <!-- 快捷记录 -->
    <view class="quick">
      <view class="quick-item" bindtap="goFood">
        <view class="quick-icon">🍱</view>
        <view class="quick-text">记饮食</view>
      </view>
      <view class="quick-item" bindtap="goTraining">
        <view class="quick-icon">🏋️</view>
        <view class="quick-text">记训练</view>
      </view>
      <view class="quick-item" bindtap="goWeight">
        <view class="quick-icon">⚖️</view>
        <view class="quick-text">记体重</view>
      </view>
      <view class="quick-item" bindtap="goProgress">
        <view class="quick-icon">📈</view>
        <view class="quick-text">看统计</view>
      </view>
    </view>

  </block>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
