.overview-card {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.overview-date {
  font-size: 24rpx;
  opacity: 0.8;
}

.overview-greeting {
  font-size: 36rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.streak-badge {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
}

.streak-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.streak-text {
  font-size: 24rpx;
}

.overview-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
}

.stat-value.over {
  color: #FFD93D;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* 骨架屏 */
@keyframes skPulse {
  0% { opacity: 1; }
  50% { opacity: 0.4; }
  100% { opacity: 1; }
}

.sk-card {
  padding: 32rpx;
  background: #fff;
  border-radius: var(--radius-lg);
}

.sk-line {
  height: 28rpx;
  background: #e8e8e8;
  border-radius: 8rpx;
  animation: skPulse 1.5s ease-in-out infinite;
}

.sk-w30 { width: 30%; }
.sk-w40 { width: 40%; margin-top: 16rpx; }
.sk-w50 { width: 50%; }
.sk-w60 { width: 60%; }

.sk-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
}

.sk-stat {
  flex: 1;
  text-align: center;
}

.sk-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

.sk-grid-item {
  height: 140rpx;
  background: #f0f0f0;
  border-radius: var(--radius);
  animation: skPulse 1.5s ease-in-out infinite;
}

/* 待表扬卡片 */
.praise-card {
  border: 2rpx solid #ffe0eb;
}

.praise-list {
  margin-bottom: 24rpx;
}

.praise-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}

.praise-item-icon {
  font-size: 36rpx;
}

.praise-item-info {
  flex: 1;
}

.praise-item-title {
  font-size: 28rpx;
  color: var(--text-primary);
}

.praise-item-desc {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 2rpx;
}

.praise-btn {
  width: 100%;
}

/* 表扬弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 32rpx calc(48rpx + 100rpx + env(safe-area-inset-bottom));
}

.praise-modal {
  text-align: center;
}

.praise-modal-emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.praise-modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.praise-textarea {
  width: 100%;
  min-height: 160rpx;
  background: var(--bg-page);
  border-radius: var(--radius);
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
}

.modal-actions .btn {
  flex: 1;
}

/* 表扬全屏特效 */
.praise-effect {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: praiseFadeIn 0.5s ease-out;
}

.praise-effect-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 107, 157, 0.15);
  backdrop-filter: blur(8px);
}

.praise-effect-content {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 0 60rpx;
  animation: praisePopIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.praise-hearts {
  margin-bottom: 40rpx;
}

.heart {
  display: inline-block;
  font-size: 64rpx;
  animation: heartFloat 2s ease-in-out infinite;
}

.h1 { animation-delay: 0s; }
.h2 { animation-delay: 0.3s; margin: 0 20rpx; }
.h3 { animation-delay: 0.6s; }

.praise-effect-text {
  font-size: 36rpx;
  color: #333;
  line-height: 1.6;
  font-weight: 500;
}

@keyframes praiseFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes praisePopIn {
  from { opacity: 0; transform: scale(0.5) translateY(40rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes heartFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.stat-target {
  font-size: 20rpx;
  opacity: 0.6;
}

.stat-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.2);
}

.calories-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4rpx;
  overflow: hidden;
}

.calories-progress {
  height: 100%;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 4rpx;
  transition: width 0.5s;
}

.checkin-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.checkin-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  border-radius: var(--radius);
  background: var(--bg-page);
  transition: all 0.3s;
}

.checkin-item.checked {
  background: var(--primary-light);
}

.checkin-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.checkin-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.checkin-status {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.checkin-count {
  font-size: 20rpx;
  color: var(--primary);
  margin-top: 4rpx;
  font-weight: 600;
}

.goal-content {
  padding: 8rpx 0;
}

.goal-info {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.goal-item {
  text-align: center;
  flex: 1;
}

.goal-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-light);
  margin-bottom: 8rpx;
}

.goal-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary);
}

.goal-arrow {
  font-size: 32rpx;
  color: var(--text-light);
  padding: 0 20rpx;
}

.goal-progress {
  margin-bottom: 16rpx;
}

.goal-bar {
  height: 12rpx;
  background: var(--bg-page);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.goal-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--secondary));
  border-radius: 6rpx;
  transition: width 0.5s;
}

.goal-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
}

.goal-days {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 12rpx;
}

.partner-status {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.partner-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  background: var(--bg-page);
}

.partner-avatar image {
  width: 100%;
  height: 100%;
}

.partner-info {
  flex: 1;
}

.partner-name {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.partner-checkins {
  display: flex;
  gap: 12rpx;
}

.partner-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--bg-page);
  color: var(--text-light);
}

.partner-tag.done {
  background: #E8F5E9;
  color: #4CAF50;
}

.like-btn {
  display: flex;
  align-items: center;
  background: var(--bg-page);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.like-btn.liked {
  background: #FFEBEE;
  color: #E85D5D;
}

.like-btn text:first-child {
  margin-right: 8rpx;
}

.partner-message {
  margin-bottom: 16rpx;
}

.message-bubble {
  background: var(--primary-light);
  padding: 20rpx 24rpx;
  border-radius: var(--radius);
  font-size: 26rpx;
  color: var(--text-primary);
}

.message-input-area {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.message-input {
  flex: 1;
  background: var(--bg-page);
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  height: 72rpx;
}

.send-btn {
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  line-height: 1.5;
}

.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reminder-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--bg-page);
  border-radius: var(--radius);
}

.reminder-item.done {
  opacity: 0.6;
}

.reminder-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.reminder-content {
  flex: 1;
}

.reminder-name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.reminder-time {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.reminder-source {
  font-size: 20rpx;
  color: #ff6b9d;
  margin-top: 4rpx;
}

.reminder-item.partner-sourced {
  border: 2rpx solid #ffe0eb;
}

/* 净热量模式 */
.stat-value.net-mode {
  color: #7FFFD4;
}

/* ===== 分类记录列表（伴侣视角） ===== */
.category-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.category-group {
  background: var(--bg-page);
  border-radius: var(--radius);
  overflow: hidden;
}

.category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}

.category-header:active {
  background: rgba(0, 0, 0, 0.02);
}

.category-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.category-icon {
  font-size: 32rpx;
}

.category-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.category-count {
  font-size: 22rpx;
  color: var(--text-light);
}

.category-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.category-summary {
  font-size: 22rpx;
  color: var(--text-light);
}

.category-arrow {
  font-size: 32rpx;
  color: var(--text-light);
  transition: transform 0.2s;
}

.category-arrow.expanded {
  transform: rotate(90deg);
}

.category-records {
  padding: 0 16rpx 16rpx;
}

.category-records .task-item {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: var(--radius);
}

.task-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  background: var(--bg-page);
  border-radius: var(--radius);
}

.task-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.task-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.task-info {
  flex: 1;
  min-width: 0;
}

.task-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-desc {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-time {
  font-size: 20rpx;
  color: var(--text-light);
  flex-shrink: 0;
}

.task-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.task-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  transition: all 0.2s;
}

.task-action:active {
  background: rgba(0, 0, 0, 0.05);
}

/* ===== 评论弹窗标题栏 ===== */
.modal-title-bar {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ===== 主角任务入口卡片 ===== */
.task-entry-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.task-entry-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.task-entry-icon {
  font-size: 40rpx;
}

.task-entry-info {
  flex: 1;
}

.task-entry-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.task-entry-desc {
  font-size: 22rpx;
  color: var(--warning);
  margin-top: 2rpx;
}

.task-entry-arrow {
  font-size: 36rpx;
  color: var(--text-light);
}

/* ===== 头像昵称设置弹窗 ===== */
.userinfo-modal {
  text-align: center;
  padding-top: 56rpx;
}

.userinfo-modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.userinfo-modal-desc {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.avatar-picker-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0 auto;
  background: transparent;
  border: none;
  border-radius: 50%;
  position: relative;
  line-height: 1;
  overflow: visible;
}

.avatar-picker-btn::after {
  border: none;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--bg-page);
}

.avatar-edit-icon {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.nickname-input {
  width: 100%;
  background: var(--bg-page);
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 40rpx;
  text-align: center;
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 48rpx 0;
  color: var(--text-light);
  font-size: 26rpx;
}

.empty-state-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}
