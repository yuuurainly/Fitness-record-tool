.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx var(--gap-lg) 4rpx;
}

.greeting {
  font-size: var(--fs-h1);
  font-weight: 700;
  line-height: 1.2;
}

.date {
  font-size: var(--fs-cap);
  color: var(--text-light);
  margin-top: 6rpx;
}

.head-plan {
  display: flex;
  align-items: center;
  font-size: var(--fs-micro);
  color: var(--primary);
  background: var(--primary-light);
  padding: 10rpx 18rpx;
  border-radius: var(--radius-pill);
}

.empty-card {
  text-align: center;
  padding: 56rpx 40rpx;
}

.empty-title {
  font-size: var(--fs-h2);
  font-weight: 600;
  margin-bottom: var(--gap-sm);
}

.empty-desc {
  font-size: var(--fs-cap);
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: var(--gap-lg);
}

.notice-action {
  margin-top: 8rpx;
  font-weight: 600;
}

/* ---------- 主指标 ---------- */

.hero {
  padding: var(--gap-lg) var(--gap-lg) var(--gap-md);
}

.hero-label {
  font-size: var(--fs-cap);
  color: var(--text-secondary);
}

.hero-value {
  font-size: var(--fs-display);
  font-weight: 700;
  line-height: 1.15;
  margin-top: 4rpx;
}

.hero-value.is-over {
  color: var(--danger);
}

.hero-unit {
  font-size: var(--fs-cap);
  font-weight: 500;
  color: var(--text-light);
  margin-left: 10rpx;
}

.hero-track {
  height: 10rpx;
  background: var(--track);
  border-radius: var(--radius-pill);
  overflow: hidden;
  margin: var(--gap-md) 0 var(--gap-sm);
}

.hero-fill {
  height: 100%;
  background: var(--primary);
  border-radius: var(--radius-pill);
  transition: width 0.3s ease;
}

.hero-fill.is-over {
  background: var(--danger);
}

.hero-foot {
  display: flex;
  justify-content: space-between;
  font-size: var(--fs-micro);
  color: var(--text-secondary);
}

.hero-note {
  margin-top: var(--gap-sm);
  font-size: var(--fs-micro);
  color: var(--text-light);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--gap-xs);
}

/* ---------- 双列 ---------- */

.duo {
  display: flex;
  gap: var(--gap-md);
}

.duo-card {
  flex: 1;
  padding: var(--gap-md);
  margin-bottom: var(--gap-md);
}

.duo-label {
  font-size: var(--fs-micro);
  color: var(--text-secondary);
}

.duo-value {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-top: 4rpx;
}

.duo-unit {
  font-size: var(--fs-micro);
  font-weight: 500;
  color: var(--text-light);
  margin-left: 6rpx;
}

.duo-foot {
  font-size: var(--fs-micro);
  color: var(--text-light);
  margin-top: 2rpx;
}

/* ---------- 快捷入口 ---------- */

.quick {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  padding: var(--gap-md) 0;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-item:active {
  opacity: 0.6;
}

.quick-icon {
  font-size: 44rpx;
  line-height: 1;
}

.quick-text {
  font-size: var(--fs-micro);
  color: var(--text-secondary);
  margin-top: 10rpx;
}
