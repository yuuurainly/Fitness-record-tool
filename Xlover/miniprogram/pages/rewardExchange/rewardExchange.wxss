.points-card {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  border-radius: var(--radius-lg);
  padding: 40rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 24rpx;
}

.points-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.points-value {
  font-size: 64rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.reward-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reward-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--bg-page);
  border-radius: var(--radius);
}

.reward-item.can-exchange {
  border: 2rpx solid var(--primary);
}

.reward-info {
  flex: 1;
}

.reward-name {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.reward-points {
  font-size: 26rpx;
  color: var(--warning);
  margin-top: 4rpx;
}

.reward-btn {
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 28rpx;
  line-height: 1.5;
}

.claim-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.claim-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--bg-page);
  border-radius: var(--radius);
}

.claim-name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.claim-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.claim-status.pending {
  background: #FFF3E0;
  color: #FF9800;
}

.claim-status.completed {
  background: #E8F5E9;
  color: #4CAF50;
}
