.record-menu {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow);
  position: relative;
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}

.food-icon {
  background: #E8F5E9;
}

.exercise-icon {
  background: #E3F2FD;
}

.weight-icon {
  background: #FFF3E0;
}

.menu-info {
  flex: 1;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.menu-desc {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-light);
  margin-right: 16rpx;
}

.menu-today {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  min-width: 120rpx;
  text-align: right;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--bg-page);
  border-radius: var(--radius);
}

.record-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  width: 48rpx;
  text-align: center;
}

.record-content {
  flex: 1;
}

.record-name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.record-detail {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.record-value {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
  margin-right: 16rpx;
}

.record-time {
  font-size: 22rpx;
  color: var(--text-light);
}
